<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="e2_occurrence_queue_v1.db" />
        <exclude domain="database" path="e2_occurrence_queue_v1.db-journal" />
        <exclude domain="database" path="e2_occurrence_queue_v1.db-wal" />
        <exclude domain="database" path="e2_occurrence_queue_v1.db-shm" />
        <exclude domain="file" path="e2_queue_images_v1/" />
        <!-- flutter_secure_storage's named EncryptedSharedPreferences artifact. -->
        <exclude domain="sharedpref" path="pavimenta_ai_mobile_secure_storage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="e2_occurrence_queue_v1.db" />
        <exclude domain="database" path="e2_occurrence_queue_v1.db-journal" />
        <exclude domain="database" path="e2_occurrence_queue_v1.db-wal" />
        <exclude domain="database" path="e2_occurrence_queue_v1.db-shm" />
        <exclude domain="file" path="e2_queue_images_v1/" />
        <!-- flutter_secure_storage's named EncryptedSharedPreferences artifact. -->
        <exclude domain="sharedpref" path="pavimenta_ai_mobile_secure_storage.xml" />
    </device-transfer>
</data-extraction-rules>
